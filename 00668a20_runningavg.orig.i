    inline uint64 System::getCycleCount() {
        uint32 timehi, timelo;
        __asm
            {
                rdtsc;
                mov timehi, edx;
                mov timelo, eax;
            }
        return ((uint64)timehi << 32) + (uint64)timelo;
    }
