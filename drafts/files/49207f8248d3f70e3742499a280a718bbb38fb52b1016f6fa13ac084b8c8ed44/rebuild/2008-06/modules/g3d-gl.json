{
 "name": "G3D-GL",
 "description": "G3D 6.09 GLG3D with 2008 Roblox patches. SDL 1.2.9 from the G3D demo is a support runtime; its original-client provenance is not established.",
 "force_owned": true,
 "depends": [
  "g3d",
  "libpng"
 ],
 "import_support_dlls": [
  "tools/libs/g3d-6.09/source/demos/SDL.dll"
 ],
 "layers": [
  {
   "name": "upstream",
   "mode": "recipe",
   "recipe": "g3d-6.09-rbx2008",
   "files": "GLG3Dcpp/*.cpp",
   "direct": true,
   "flags": "/O2 /GS- /EHsc /MD",
   "extra_defines": "NO_SDL_MAIN"
  },
  {
   "name": "tonemap",
   "mode": "recipe",
   "recipe": "g3d-6.09-rbx2008",
   "files": "contrib/ArticulatedModel/ToneMap.cpp",
   "direct": true,
   "flags": "/O2 /GS- /EHsc /MD",
   "extra_defines": "NO_SDL_MAIN"
  }
 ],
 "test": "g3d_gl",
 "test_includes": [
  "rebuild/2008-06/out/G3D-GL/force",
  "tree:g3d-6.09-rbx2008/include",
  "tools/libs/SDL-1.2.11/include"
 ]
}
