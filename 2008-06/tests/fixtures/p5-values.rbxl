<Item class="Script"><Properties><string name="Name">ValueTest</string><string name="Source">local w=game.Workspace
assert(w.Count.Value==17 and w.Label.Value=="hello" and w.Amount.Value==2.5 and w.Switch.Value and w.Target.Value==w.Brick)
assert(w.Vector.Value.x==2 and w.Color.Value.r==0.25 and w.ColorNumber.Value.Number==21 and w.Frame.Value.p.x==6)
local changes=0
w.Count.Changed:connect(function(v) if v==19 then changes=changes+1 end end)
w.Target.Changed:connect(function(v) if v==nil then changes=changes+1 end end)
w.Vector.Changed:connect(function(v) if v.x==9 then changes=changes+1 end end)
w.Color.Changed:connect(function(v) if v.r==0.5 then changes=changes+1 end end)
w.ColorNumber.Changed:connect(function(v) if v.Number==24 then changes=changes+1 end end)
w.Frame.Changed:connect(function(v) if v.p.x==10 then changes=changes+1 end end)
w.Vector.Value=Vector3.new(9,8,7); w.Color.Value=Color3.new(0.5,0.25,0.75); w.ColorNumber.Value=BrickColor.new(24); w.Frame.Value=CFrame.new(10,11,12)
assert(w.Vector.Value.x==9 and w.Color.Value.r==0.5 and w.ColorNumber.Value.Number==24 and w.Frame.Value.p.x==10)
w.Count.Value=19; w.Label.Value="changed"; w.Amount.Value=3.5; w.Switch.Value=false; w.Target.Value=nil
assert(w.Count.Value==19 and w.Label.Value=="changed" and w.Amount.Value==3.5 and not w.Switch.Value and w.Target.Value==nil)
assert(changes==6)
w.Brick.CFrame=CFrame.new(3,4,5)
print("VALUES_PASS")</string><bool name="Disabled">false</bool></Properties></Item></Item></roblox>