{
  "name": "P2TextureInterop",
  "description": "Clean genuine GLG3D providers needed by native texture legacy-reference branch; no verified sink layer; unrelated SDL GApp bootstrap excluded",
  "depends": [
    "p2-image-core"
  ],
  "layers": [
    {
      "name": "upstream",
      "mode": "recipe",
      "recipe": "g3d-6.09-rbx2008",
      "files": "GLG3Dcpp/*.cpp",
      "direct": true,
      "flags": "/O2 /GS- /EHsc /MD",
      "exclude": [
        "GLG3Dcpp/GApp.cpp"
      ]
    },
    {
      "name": "tonemap",
      "mode": "recipe",
      "recipe": "g3d-6.09-rbx2008",
      "files": "contrib/ArticulatedModel/ToneMap.cpp",
      "direct": true,
      "flags": "/O2 /GS- /EHsc /MD"
    }
  ],
  "test": "P2TextureInteropTest",
  "test_includes": [
    "tree:g3d-6.09-rbx2008/include",
    "tools/libs/SDL-1.2.11/include"
  ],
  "verified": false
}
