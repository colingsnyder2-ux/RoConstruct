# Client files are proprietary: only the registry and docs are tracked.
clients/*
!clients/README.md
!clients/clients.json

# Matched sources reproduce Roblox code. Kept local until the group decides to
# publish them (takedown risk). Delete this line to track src/.
src/

# Local runtime state and output
work/
tools/
*.db
*.log
roconstruct-settings.json

# Old pre-rewrite scripts, kept on disk until the port is done
scripts/

# Python / build
__pycache__/
*.pyc
build/
dist/
*.spec
