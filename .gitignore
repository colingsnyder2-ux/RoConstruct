# Client files are proprietary: only the registry, sources, and docs are tracked.
clients/*
!clients/clients.json
!clients/sources.json
!clients/donor.json

# Matched-source findings live in the separate RoConstruct-findings repository.
# Keep the local findings checkout ignored here so normal RoConstruct clones
# stay small.
src/

# Local runtime state and output
work/
local/
tools/
*.db
*.log
*.key
roconstruct-settings.json
roconstruct-providers.json
roconstruct-secrets.json
roconstruct-worker.json

# Local investigation scratch / downloaded archives
check_*.py
final_status.py
investigate*.py
test_out.txt
clients.zip
r2009.zip

# Retired folders (now under local/) and legacy root config copies
scripts/

# Python / build
__pycache__/
.pytest_cache/
*.pyc
build/
dist/
*.spec

# Website data: published to the gh-pages branch, never committed to main
docs/data/
docs/integration.json

# Native rebuilds are published in RoConstruct-findings/2008-06.
/rebuild/

# Compiler scratch belongs under work/.
/*.obj
/*.asm
/*.cod
/*.i
/*.err
/*.out
/*_trials.zip

# Per-agent goals and research writer locks stay local.
/.opencode/goals/
/research/*.lock
