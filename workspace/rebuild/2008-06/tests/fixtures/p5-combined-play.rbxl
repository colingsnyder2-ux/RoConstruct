<roblox version="4"><Item class="Workspace"><Properties /><Item class="Part"><Properties><string name="Name">Floor</string><bool name="Anchored">true</bool><Vector3 name="size"><X>60</X><Y>2</Y><Z>60</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>-1</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Part"><Properties><string name="Name">Trigger</string><bool name="Anchored">true</bool><int name="BrickColor">21</int><Vector3 name="size"><X>6</X><Y>4</Y><Z>1</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>2</Y><Z>18</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Part"><Properties><string name="Name">Brick</string><bool name="Anchored">true</bool><int name="BrickColor">24</int><Vector3 name="size"><X>3</X><Y>2</Y><Z>3</Z></Vector3><CoordinateFrame name="CFrame"><X>8</X><Y>12</Y><Z>12</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Script"><Properties><string name="Name">TriggerScript</string><string name="Source">local fired=false
game.Workspace.Trigger.Touched:connect(function(other)
 if fired or not other.Parent or not other.Parent:FindFirstChild("Humanoid") then return end
 fired=true
 local b=game.Workspace.Brick
 print("TRIGGER_FIRED"); print("COMBINED_TRIGGER")
 b.Anchored=false
 wait(0.15)
 b.Anchored=true
 print("COMBINED_ANCHOR")
 wait(0.15)
 b.Anchored=false
 print("COMBINED_RELEASE")
end)</string><bool name="Disabled">false</bool></Properties></Item></Item></roblox>